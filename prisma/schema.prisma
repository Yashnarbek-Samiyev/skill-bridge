generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  name          String
  username      String         @unique
  password      String
  role          String
  phone         String?
  groupId       String?
  createdAt     DateTime       @default(now())
  ledGroups     Group[]        @relation("GroupLeader")
  messages      Message[]      @relation("UserMessages")
  notifications Notification[] @relation("UserNotifications")
  orders        Order[]        @relation("ClientOrders")
  reviews       Review[]       @relation("ClientReviews")
  tasks         Task[]         @relation("StudentTasks")
  group         Group?         @relation(fields: [groupId], references: [id])
}

model Group {
  id          String    @id @default(uuid())
  name        String
  directionId String
  region      String
  leaderId    String?
  balance     Float     @default(0.0)
  createdAt   DateTime  @default(now())
  leader      User?     @relation("GroupLeader", fields: [leaderId], references: [id])
  direction   Direction @relation(fields: [directionId], references: [id])
  orders      Order[]
  reviews     Review[]
  students    User[]
}

model Direction {
  id       String    @id @default(uuid())
  name     String
  groups   Group[]
  services Service[]
}

model Service {
  id          String    @id @default(uuid())
  name        String
  directionId String
  basePrice   Float     @default(0.0)
  unit        String    @default("dona")
  orders      Order[]
  direction   Direction @relation(fields: [directionId], references: [id])
}

model Order {
  id          String    @id @default(uuid())
  clientId    String
  serviceId   String
  groupId     String?
  description String
  address     String
  region      String
  deadline    DateTime?
  status      String    @default("PENDING")
  price       Float
  qty         Int       @default(1)
  fileUrl     String?
  createdAt   DateTime  @default(now())
  messages    Message[]
  group       Group?    @relation(fields: [groupId], references: [id])
  service     Service   @relation(fields: [serviceId], references: [id])
  client      User      @relation("ClientOrders", fields: [clientId], references: [id])
  review      Review?
  tasks       Task[]
}

model Task {
  id           String   @id @default(uuid())
  orderId      String
  title        String
  status       String   @default("TODO")
  assignedToId String?
  result       String?
  createdAt    DateTime @default(now())
  assignedTo   User?    @relation("StudentTasks", fields: [assignedToId], references: [id])
  order        Order    @relation(fields: [orderId], references: [id])
}

model Review {
  id        String   @id @default(uuid())
  orderId   String   @unique
  clientId  String
  groupId   String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id])
  client    User     @relation("ClientReviews", fields: [clientId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id])
}

model Message {
  id        String   @id @default(uuid())
  orderId   String
  senderId  String
  content   String
  createdAt DateTime @default(now())
  sender    User     @relation("UserMessages", fields: [senderId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  type      String   @default("INFO")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
}
