# ==============================================
# Skill-Bridge Platform — Environment Variables
# ==============================================
# Copy this file to .env.local for local development
# Set these variables in Vercel Dashboard for production

# ── DATABASE (Neon PostgreSQL) ─────────────────
# Get from: https://neon.tech → Your Project → Connection Details
# "Pooled connection" URL:
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&pgbouncer=true"

# "Direct connection" URL (for migrations):
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ── AUTH (JWT Session Secret) ──────────────────
# Generate a secure random string (min 32 chars):
# Run: openssl rand -base64 32
SESSION_SECRET="your-super-secret-random-key-here-minimum-32-chars"

# ── NEXT.JS ────────────────────────────────────
# Automatically set by Vercel, no need to change:
# NEXT_PUBLIC_VERCEL_URL=...
